<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Design нужен dotnet-ef в startup-проекте; runtime-пакеты находятся в Infrastructure. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.2" />
  </ItemGroup>

  <!-- Исключаем исходники и ресурсы вложенных проектов из веб-проекта. -->
  <ItemGroup>
    <Compile Remove="ProjectWork.Tests\**" />
    <Content Remove="ProjectWork.Tests\**" />
    <None Remove="ProjectWork.Tests\**" />
    <EmbeddedResource Remove="ProjectWork.Tests\**" />
    <Compile Remove="ProjectWork.IntegrationTests\**" />
    <Content Remove="ProjectWork.IntegrationTests\**" />
    <None Remove="ProjectWork.IntegrationTests\**" />
    <EmbeddedResource Remove="ProjectWork.IntegrationTests\**" />
    <Compile Remove="ProjectWork.PresentationTests\**" />
    <Content Remove="ProjectWork.PresentationTests\**" />
    <None Remove="ProjectWork.PresentationTests\**" />
    <EmbeddedResource Remove="ProjectWork.PresentationTests\**" />
	
	<Compile Remove="ProjectWork.Domain\**" />
    <Content Remove="ProjectWork.Domain\**" />
    <None Remove="ProjectWork.Domain\**" />
    <EmbeddedResource Remove="ProjectWork.Domain\**" />

    <Compile Remove="ProjectWork.Application\**" />
    <Content Remove="ProjectWork.Application\**" />
    <None Remove="ProjectWork.Application\**" />
    <EmbeddedResource Remove="ProjectWork.Application\**" />

    <Compile Remove="ProjectWork.Infrastructure\**" />
    <Content Remove="ProjectWork.Infrastructure\**" />
    <None Remove="ProjectWork.Infrastructure\**" />
    <EmbeddedResource Remove="ProjectWork.Infrastructure\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="ProjectWork.Application\ProjectWork.Application.csproj" />
    <ProjectReference Include="ProjectWork.Infrastructure\ProjectWork.Infrastructure.csproj" />
  </ItemGroup>

</Project>
